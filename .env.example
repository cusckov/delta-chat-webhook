# Шаблон конфигурации окружения.
#
#   cp .env.example .env
#
# и заполни значения. Сам .env в репозиторий не попадает (см. .gitignore),
# .env.example — попадает, чтобы было видно, какие переменные нужны.
#
# ВАЖНО: порт в ASPNETCORE_URLS должен совпадать с маппингом портов
# в docker-compose.yml ("8082:8082").

# ── HTTP ─────────────────────────────────────────────────────────────
ASPNETCORE_URLS=http://+:8082

# ── Delta Chat account ─────────────────────────────────────────────
# email аккаунта бота
DC_EMAIL=webhook@yourdomain.com
# пароль от аккаунта бота
DC_PASSWORD=your_email_password
# путь внутри контейнера, где лежат данные аккаунта
DC_ACCOUNTS_PATH=/data/accounts

# ── SMTP relay ─────────────────────────────────────────────────────
# SMTP_SECURITY: ssl | starttls | plain
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURITY=ssl

# ── IMAP ────────────────────────────────────────────────────────────
# IMAP_SECURITY: ssl | starttls | plain
IMAP_HOST=imap.beget.com
IMAP_PORT=993
IMAP_SECURITY=ssl

# ── Webhook auth ────────────────────────────────────────────────────
# Кастомный заголовок, который отправитель (Dokploy, curl, CI, ...) обязан
# передать в POST-запросах к /webhook/* и /dokploy/*. Значение сверяется
# с WEBHOOK_AUTH_TOKEN; при несовпадении приходит 401.
#
# WEBHOOK_AUTH_HEADER — имя заголовка (по умолчанию X-Webhook-Token);
# WEBHOOK_AUTH_TOKEN  — секрет. Оставь пустым, чтобы отключить проверку
#                       (тогда эндпоинты останутся открытыми для всех).
#
# ОБЯЗАТЕЛЬНО замени значение ниже на длинный случайный секрет, например:
#   openssl rand -hex 32
WEBHOOK_AUTH_HEADER=X-Webhook-Token
WEBHOOK_AUTH_TOKEN=replace-with-a-long-random-secret
